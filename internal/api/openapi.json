{
  "openapi": "3.1.0",
  "info": {
    "title": "Goldberry API",
    "version": "1.0.0",
    "description": "Goldberry's JSON API (ADR 0015). Amounts are integers in minor units (cents for USD); the household currency says what a unit is. Times are RFC 3339 in UTC. Authenticate with `Authorization: Bearer gb_…`; tokens are minted on a parent's People page. Errors share one shape and a stable `code`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "summary": "Get the OpenAPI spec",
        "operationId": "GetTheOpenapiSpec",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    },
