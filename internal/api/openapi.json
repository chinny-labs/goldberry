  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Goldberry API token (gb_…)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "detail": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Currency": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "exponent": {
            "type": "integer"
          },
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "exponent",
          "symbol"
        ],
        "additionalProperties": false
      },
      "Household": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "timezone": {
            "type": "string"
          },
          "allow_negative": {
            "type": "boolean"
          },
          "request_expiry_days": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "currency",
          "timezone",
          "allow_negative",
          "request_expiry_days"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "kid"
            ]
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "disabled"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write",
                "money"
              ]
            }
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "user",
          "token_id",
          "label",
          "scopes",
          "last_used_at"
        ],
        "additionalProperties": false
      },
      "Kid": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Sum of jar balances, minor units."
          },
          "held": {
            "type": "integer",
            "format": "int64",
            "description": "Sum of pending holds."
          },
          "available": {
            "type": "integer",
            "format": "int64",
            "description": "total − held."
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "disabled",
          "total",
          "held",
          "available"
        ],
        "additionalProperties": false
      },
      "Lock": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "jar_id": {
            "type": "string"
          },
          "to_jar_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "set_by_role": {
            "enum": [
              "admin",
              "kid"
            ]
          },
          "hard": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "until_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "jar_id",
          "to_jar_id",
          "set_by_role",
          "hard",
          "reason",
          "until_date",
          "created_at"
        ],
        "additionalProperties": false
      },
      "Jar": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kid_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "spend",
              "save",
              "give",
              "invest",
              "custom"
            ]
          },
          "sort_order": {
            "type": "integer"
          },
          "archived": {
            "type": "boolean"
          },
          "balance": {
            "type": "integer",
            "format": "int64"
          },
          "held": {
            "type": "integer",
            "format": "int64"
          },
          "available": {
            "type": "integer",
            "format": "int64"
          },
          "split_bps": {
            "type": "integer",
            "description": "Share of a split deposit, in basis points (10000 = 100%)."
          },
          "locks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lock"
            }
          }
        },
        "required": [
          "id",
          "kid_id",
          "name",
          "kind",
          "sort_order",
          "archived",
          "balance",
          "held",
          "available",
          "split_bps",
          "locks"
        ],
        "additionalProperties": false
      },
      "KidDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "held": {
            "type": "integer",
            "format": "int64"
          },
          "available": {
            "type": "integer",
            "format": "int64"
          },
          "jars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Jar"
            }
          },
          "pending_requests": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "disabled",
          "total",
          "held",
          "available",
          "jars",
          "pending_requests"
        ],
        "additionalProperties": false
      },
      "Entry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
