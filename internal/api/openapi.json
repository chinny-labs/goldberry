            "name": "kid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "A kid's ID or username."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "jar_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "RFC3339 time or YYYY-MM-DD; inclusive, on effective_at."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exclusive. Pass the last entry's effective_at to page back; entries sharing that instant are skipped, so use a window for exact paging."
          }
        ]
      }
    },
